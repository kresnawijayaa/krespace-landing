---
import BaseLayout from "../layouts/BaseLayout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import Icon from "../components/Icon.astro";
import { whatsappUrlFor, site } from "../data/site";

const options = [
  { name: "Build", icon: "Blocks", message: `Halo Krespace, saya ingin membuat website/sistem baru.\n\nJenis kebutuhan:\nSiapa yang akan menggunakan:\nProses yang ingin dibantu:\nTarget penggunaan:\nPerkiraan budget:` },
  { name: "Launch", icon: "Rocket", message: `Halo Krespace, saya sudah punya source code dan ingin membawanya online.\n\nJenis project:\nFrontend/backend:\nSudah punya domain:\nSudah punya hosting/VPS:\nKendala saat ini:` },
  { name: "Rescue", icon: "LifeBuoy", message: `Halo Krespace, saya punya website/project yang sedang bermasalah.\n\nLink project:\nKendala:\nTeknologi jika tahu:\nApakah source code tersedia:\nUrgensi:` },
  { name: "Upgrade", icon: "Wrench", message: `Halo Krespace, saya ingin menambahkan fitur atau integrasi.\n\nLink/project:\nFitur yang dibutuhkan:\nTeknologi jika tahu:\nTarget penggunaan:\nUrgensi:` },
  { name: "Care", icon: "ShieldCheck", message: `Halo Krespace, saya ingin menanyakan layanan maintenance.\n\nLink website:\nJenis website/sistem:\nHosting saat ini:\nMasalah yang sering terjadi:\nBantuan yang dibutuhkan:` },
];
---

<BaseLayout title="Hubungi Krespace Studio" description="Ceritakan kebutuhan Build, Launch, Rescue, Upgrade, atau Care melalui WhatsApp Krespace." canonicalPath="/contact">
  <Navbar />
  <main class="px-4 pb-20 pt-32 md:px-8">
    <section class="mx-auto max-w-6xl">
      <p class="text-sm font-extrabold uppercase text-teal-700">Hubungi Krespace</p>
      <h1 class="mt-4 max-w-4xl text-4xl font-extrabold leading-tight md:text-6xl">Ceritakan kondisi project, mulai dari yang kamu tahu</h1>
      <p class="mt-5 max-w-2xl text-lg font-medium text-gray-700">Pilih jalur yang paling dekat dengan kebutuhanmu. Template WhatsApp akan membantu menyiapkan informasi awal.</p>
      <div class="mt-12 grid gap-5 md:grid-cols-2 lg:grid-cols-5">
        {options.map((option) => <a href={whatsappUrlFor(option.message)} target="_blank" rel="noopener noreferrer" class="neo-card flex flex-col p-5"><Icon name={option.icon} class="h-7 w-7 text-teal-700" /><h2 class="mt-6 text-xl font-extrabold">{option.name}</h2><span class="mt-3 text-sm font-bold text-gray-500">Buka WhatsApp →</span></a>)}
      </div>
      <div class="mt-12 rounded-2xl border-2 border-dark bg-yellow-50 p-6 shadow-neo-sm">
        <h2 class="text-2xl font-extrabold">Lebih nyaman lewat email?</h2>
        <a href={`mailto:${site.email}`} class="mt-3 inline-block font-bold text-teal-800 underline underline-offset-4">{site.email}</a>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
