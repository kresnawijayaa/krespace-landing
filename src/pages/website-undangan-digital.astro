---
import BaseLayout from "../layouts/BaseLayout.astro";
import Navbar from "../components/Navbar.astro";
import ServicePage from "../components/ServicePage.astro";
import Footer from "../components/Footer.astro";
import { servicePages } from "../data/services";
const page = servicePages.find((item) => item.slug === "website-undangan-digital")!;
---

<BaseLayout title={page.title} description={page.description} canonicalPath="/website-undangan-digital">
  <Navbar />
  <ServicePage h1={page.h1} lead={page.lead} bullets={page.bullets} />
  <Footer />
</BaseLayout>
