---
import Icon from "./Icon.astro";
import { customIdeas } from "../data/services";
---

<section class="border-y-2 border-dark bg-[#F3E8FF] px-4 py-20 md:px-8">
  <div class="mx-auto max-w-6xl">
    <div class="mx-auto mb-12 max-w-2xl text-center">
      <h2 class="mb-4 text-3xl font-extrabold md:text-4xl">Punya ide yang agak beda?</h2>
      <p class="text-lg text-gray-700">Selain website bisnis dan sistem kerja, kami juga terbuka untuk project digital yang lebih personal atau unik.</p>
    </div>

    <div class="mb-10 grid gap-6 md:grid-cols-2 lg:grid-cols-4">
      {customIdeas.map((idea) => (
        <a href={idea.href} class="rounded-xl border-2 border-dark bg-white p-6 shadow-neo transition-transform hover:-translate-y-1">
          <div class={`mb-4 flex h-10 w-10 items-center justify-center rounded-lg border-2 border-dark shadow-neo-sm ${idea.bgClass}`}>
            <Icon name={idea.icon} class={`h-5 w-5 ${idea.iconClass}`} />
          </div>
          <h3 class="mb-2 text-lg font-bold">{idea.title}</h3>
          <p class="text-sm text-gray-600">{idea.description}</p>
        </a>
      ))}
    </div>

    <div class="mx-auto max-w-3xl rounded-xl border-2 border-dark bg-white p-6 text-center shadow-neo-sm">
      <p class="font-bold text-gray-800">Selama masih bisa dibuat dalam bentuk website, halaman interaktif, atau sistem sederhana, kami terbuka untuk ngobrol dulu.</p>
    </div>
  </div>
</section>
