---
const steps = [
  ["1", "Ceritakan kondisi", "Mulai dari kebutuhan, kendala, atau kondisi source code yang ada.", "bg-yellow-300"],
  ["2", "Pemeriksaan awal", "Kami cek akses, teknologi, risiko, dan informasi yang masih kurang.", "bg-orange-500 text-white"],
  ["3", "Scope & estimasi", "Batas pekerjaan, hasil, waktu, dan biaya dibuat jelas sebelum mulai.", "bg-purple-500 text-white"],
  ["4", "Kerjakan & catat", "Project dikerjakan bertahap dan perubahan penting didokumentasikan.", "bg-teal-500 text-white"],
  ["5", "Launch / handover / Care", "Project dibawa online, diserahkan, atau dilanjutkan dengan perawatan.", "bg-lime-500"],
];
---

<section id="cara-kerja" class="border-y-2 border-dark bg-yellow-50 px-4 py-20 md:px-8">
  <div class="mx-auto max-w-6xl">
    <div class="mb-14 text-center">
      <p class="mb-3 text-sm font-extrabold uppercase text-yellow-700">Cara kerja</p>
      <h2 class="text-3xl font-extrabold md:text-5xl">Jelas dari pemeriksaan sampai handover</h2>
    </div>
    <ol class="grid gap-4 md:grid-cols-5">
      {steps.map(([number, title, description, className]) => (
        <li class="relative border-2 border-dark bg-white p-5 shadow-neo-sm">
          <div class={`mb-6 flex h-11 w-11 items-center justify-center rounded-full border-2 border-dark text-lg font-extrabold ${className}`}>{number}</div>
          <h3 class="mb-2 text-lg font-extrabold">{title}</h3>
          <p class="text-sm leading-relaxed text-gray-600">{description}</p>
        </li>
      ))}
    </ol>
  </div>
</section>
