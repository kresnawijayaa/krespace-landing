---
import {
  Activity,
  ArrowRight,
  Blocks,
  Calendar,
  CheckCircle2,
  ChevronDown,
  ChevronLeft,
  ChevronRight,
  Clock,
  Code2,
  ClipboardList,
  Cloud,
  CreditCard,
  Database,
  ExternalLink,
  FileSpreadsheet,
  FileWarning,
  Filter,
  FolderCheck,
  Gift,
  Globe,
  Heart,
  HelpCircle,
  Info,
  LayoutDashboard,
  LayoutTemplate,
  LifeBuoy,
  LockKeyhole,
  Lightbulb,
  Menu,
  MessageCircle,
  MessageSquare,
  Maximize2,
  Package,
  MapPin,
  Receipt,
  Rocket,
  SearchX,
  ShieldCheck,
  Server,
  User,
  Wrench,
  X,
  XCircle,
} from "lucide-astro";

const icons = {
  Activity,
  ArrowRight,
  Blocks,
  Calendar,
  CheckCircle2,
  ChevronDown,
  ChevronLeft,
  ChevronRight,
  Clock,
  Code2,
  ClipboardList,
  Cloud,
  CreditCard,
  Database,
  ExternalLink,
  FileSpreadsheet,
  FileWarning,
  Filter,
  FolderCheck,
  Gift,
  Globe,
  Heart,
  HelpCircle,
  Info,
  LayoutDashboard,
  LayoutTemplate,
  LifeBuoy,
  LockKeyhole,
  Lightbulb,
  Menu,
  MessageCircle,
  MessageSquare,
  Maximize2,
  Package,
  MapPin,
  Receipt,
  Rocket,
  SearchX,
  ShieldCheck,
  Server,
  User,
  Wrench,
  X,
  XCircle,
};

interface Props {
  name: keyof typeof icons | string;
  class?: string;
}

const { name, class: className = "w-5 h-5" } = Astro.props;
const Component = icons[name as keyof typeof icons] ?? HelpCircle;
---

<Component class={className} aria-hidden="true" />
