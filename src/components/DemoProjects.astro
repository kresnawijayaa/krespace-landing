---
import Icon from "./Icon.astro";
import { demos } from "../data/demos";

interface Props {
  standalone?: boolean;
}

const { standalone = false } = Astro.props;
---

<section id="demo" class={`${standalone ? "pt-32" : ""} border-b-2 border-dark bg-gray-900 px-4 py-20 text-white md:px-8`}>
  <div class="mx-auto max-w-6xl">
    <div class="mb-12 text-center md:text-left">
      <h2 class="mb-4 text-3xl font-extrabold md:text-4xl">{standalone ? "Demo Project" : "Coba lihat contoh sistemnya"}</h2>
      <p class="max-w-2xl text-lg text-gray-400">Beberapa demo menggunakan data fiktif, supaya kamu bisa lihat gambaran nyata sistem yang bisa dibuat.</p>
    </div>

    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-4">
      {demos.map((demo) => (
        <article class="flex flex-col rounded-xl border-2 border-dark bg-white p-6 text-dark shadow-neo transition-transform hover:-translate-y-1">
          <div class="mb-4 flex items-center gap-3">
            <div class={`rounded-lg border-2 border-dark p-2 shadow-[2px_2px_0px_0px_#111827] ${demo.bgClass}`}>
              <Icon name={demo.icon} class={`h-5 w-5 ${demo.iconClass}`} />
            </div>
            <h3 class="text-xl font-bold">{demo.title}</h3>
          </div>
          <p class="mb-4 flex-1 text-sm text-gray-600">{demo.description}</p>
          <div class="mb-6 flex flex-wrap gap-1.5">
            {demo.tags.map((tag) => <span class="rounded-md border-2 border-dark bg-gray-100 px-2 py-1 text-[10px] font-bold">{tag}</span>)}
          </div>
          <a href="/kontak" class="neo-btn w-full bg-dark py-2.5 text-sm text-white">Lihat Demo</a>
        </article>
      ))}
    </div>
  </div>
</section>
