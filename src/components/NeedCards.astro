---
import Icon from "./Icon.astro";
import { visitorStages } from "../data/services";
---

<section class="bg-white px-4 py-20 md:px-8">
  <div class="mx-auto max-w-6xl">
    <div class="mb-12 max-w-3xl">
      <p class="mb-3 text-sm font-extrabold uppercase text-teal-700">Mulai dari kondisimu</p>
      <h2 class="text-3xl font-extrabold md:text-5xl">Kamu sedang berada di tahap mana?</h2>
    </div>
    <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-6">
      {visitorStages.map((card, index) => (
        <a href={card.href} class={`group border-2 border-dark bg-white p-5 shadow-neo transition-transform hover:-translate-y-1 ${index < 2 ? "lg:col-span-3" : "lg:col-span-2"}`}>
          <div class="mb-6 flex items-start justify-between">
            <div class={`flex h-11 w-11 items-center justify-center rounded-xl border-2 border-dark ${card.bgClass}`}>
              <Icon name={card.icon} class={`h-5 w-5 ${card.accentClass}`} />
            </div>
            <span class={`text-sm font-extrabold ${card.accentClass}`}>{card.service}</span>
          </div>
          <h3 class="mb-2 text-xl font-extrabold">{card.title}</h3>
          <p class="text-sm leading-relaxed text-gray-600">{card.description}</p>
        </a>
      ))}
    </div>
  </div>
</section>
