---
import ServiceCard from "./ServiceCard.astro";
import { services } from "../data/services";
---

<section id="layanan" class="border-y-2 border-dark bg-teal-50 px-4 py-20 md:px-8">
  <div class="mx-auto max-w-6xl">
    <div class="mb-12 grid gap-5 md:grid-cols-2 md:items-end">
      <div>
        <p class="mb-3 text-sm font-extrabold uppercase text-teal-700">Layanan Krespace</p>
        <h2 class="text-3xl font-extrabold md:text-5xl">Tidak berhenti ketika coding selesai</h2>
      </div>
      <p class="max-w-xl text-lg font-medium leading-relaxed text-gray-700 md:justify-self-end">
        Pilih berdasarkan hasil yang kamu butuhkan sekarang. Scope teknisnya kita susun setelah kondisi project dipahami.
      </p>
    </div>
    <div class="grid overflow-hidden border-2 border-dark bg-dark gap-[2px] md:grid-cols-2 lg:grid-cols-3">
      {services.map((service, index) => <ServiceCard {...service} index={index} />)}
    </div>
  </div>
</section>
