---
import { pricing } from "../data/pricing";
import { whatsappUrlFor } from "../data/site";
---

<section id="harga" class="px-4 py-20 md:px-8">
  <div class="mx-auto max-w-6xl">
    <div class="mb-12 grid gap-5 md:grid-cols-2 md:items-end">
      <div>
        <p class="mb-3 text-sm font-extrabold uppercase text-purple-700">Estimasi awal</p>
        <h2 class="text-3xl font-extrabold md:text-5xl">Bisa mulai dari bantuan kecil</h2>
      </div>
      <p class="text-lg font-medium text-gray-700">Estimasi final mengikuti kondisi project, teknologi, akses, urgensi, dan risiko pengerjaan.</p>
    </div>
    <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-3">
      {pricing.map((item) => {
        const message = `Halo Krespace, saya ingin menanyakan ${item.title}.

Kondisi/kebutuhan:
Teknologi jika tahu:
Urgensi:`;
        return (
          <article class="neo-card flex flex-col p-6">
            <div class={`mb-6 h-3 w-20 rounded-full border-2 border-dark ${item.accentClass}`}></div>
            <h3 class="text-xl font-extrabold">{item.title}</h3>
            <p class="mt-2 text-sm font-bold uppercase text-gray-500">Mulai dari</p>
            <p class="my-5 text-3xl font-extrabold">{item.price}</p>
            <p class="mb-7 flex-1 text-sm leading-relaxed text-gray-600">{item.description}</p>
            <a href={whatsappUrlFor(message)} target="_blank" rel="noopener noreferrer" class="neo-btn bg-white px-5 py-3">Tanya scope</a>
          </article>
        );
      })}
    </div>
  </div>
</section>
