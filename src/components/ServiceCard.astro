---
import Icon from "./Icon.astro";

interface Props {
  name: string;
  result: string;
  examples: string[];
  icon: string;
  bgClass: string;
  href: string;
  cta: string;
  index: number;
}

const { name, result, examples, icon, bgClass, href, cta, index } = Astro.props;
---

<article class={`service-card relative flex flex-col bg-white p-6 md:p-7 ${index === 0 ? "md:col-span-2" : ""}`}>
  <div class="mb-7 flex items-start justify-between gap-4">
    <div class={`flex h-12 w-12 items-center justify-center rounded-xl border-2 border-dark shadow-neo-sm ${bgClass}`}>
      <Icon name={icon} class="h-6 w-6" />
    </div>
    <span class="text-sm font-extrabold text-gray-400">0{index + 1}</span>
  </div>
  <h3 class="mb-2 text-2xl font-extrabold">{name}</h3>
  <p class="mb-6 max-w-md font-medium text-gray-700">{result}</p>
  <ul class="mb-8 grid gap-2 text-sm font-semibold text-gray-600">
    {examples.map((example) => (
      <li class="flex items-center gap-2">
        <span class="h-2 w-2 shrink-0 rounded-full bg-dark"></span>{example}
      </li>
    ))}
  </ul>
  <a href={href} class="mt-auto inline-flex items-center gap-2 font-extrabold text-dark underline decoration-2 underline-offset-4 hover:text-teal-700">
    {cta} <Icon name="ArrowRight" class="h-4 w-4" />
  </a>
</article>
