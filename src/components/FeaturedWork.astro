---
import type { CollectionEntry } from "astro:content";
import WorkCard from "./WorkCard.astro";

interface Props {
  works: CollectionEntry<"work">[];
}

const { works } = Astro.props;
---

<section id="hasil-kerja" class="border-y-2 border-dark bg-dark px-4 py-20 text-white md:px-8">
  <div class="mx-auto max-w-6xl">
    <div class="mb-12 flex flex-col justify-between gap-6 md:flex-row md:items-end">
      <div>
        <p class="mb-3 text-sm font-extrabold uppercase text-teal-300">Selected work</p>
        <h2 class="max-w-3xl text-3xl font-extrabold md:text-5xl">Hasil kerja yang benar-benar digunakan</h2>
      </div>
      <a href="/work" class="neo-btn shrink-0 bg-yellow-300 px-5 py-3 text-dark">Lihat semua hasil kerja</a>
    </div>
    <div class="grid gap-7 lg:grid-cols-2">
      {works.map((work) => <WorkCard work={work} featured />)}
    </div>
  </div>
</section>
