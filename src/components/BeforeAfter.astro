---
import Icon from "./Icon.astro";

const before = [
  "Source code hanya berjalan lokal",
  "Proses masih manual",
  "Project tidak terdokumentasi",
  "Error tidak diketahui penyebabnya",
  "Tidak ada backup",
  "Tidak ada yang menangani setelah launch",
];
const after = [
  "Project online dan dapat diakses",
  "Sistem lebih terstruktur",
  "Domain dan HTTPS aktif",
  "Perubahan terdokumentasi",
  "Alur kerja lebih jelas",
  "Ada jalur dukungan teknis",
];
---

<section class="border-b-2 border-dark bg-white px-4 py-20 md:px-8">
  <div class="mx-auto max-w-6xl">
    <div class="mb-14 max-w-3xl">
      <p class="mb-3 text-sm font-extrabold uppercase text-orange-700">Perubahan yang dicari</p>
      <h2 class="text-3xl font-extrabold md:text-5xl">Dari “sudah ada kodenya” ke benar-benar berjalan</h2>
    </div>
    <div class="relative grid gap-8 md:grid-cols-2">
      <div class="relative rounded-2xl border-2 border-dark bg-orange-50 p-7 shadow-[6px_6px_0_0_#f97316]">
        <div class="mb-7 flex items-center gap-3"><Icon name="XCircle" class="h-7 w-7 text-orange-600" /><h3 class="text-2xl font-extrabold">Sebelum</h3></div>
        <ul class="grid gap-4">
          {before.map((item) => <li class="flex items-start gap-3 font-semibold text-gray-700"><span class="mt-2 h-2 w-2 shrink-0 rounded-full bg-orange-500"></span>{item}</li>)}
        </ul>
      </div>
      <div class="relative rounded-2xl border-2 border-dark bg-teal-500 p-7 text-white shadow-neo-lg">
        <div class="mb-7 flex items-center gap-3"><Icon name="CheckCircle2" class="h-7 w-7 text-yellow-200" /><h3 class="text-2xl font-extrabold">Sesudah</h3></div>
        <ul class="grid gap-4">
          {after.map((item) => <li class="flex items-start gap-3 font-semibold text-teal-50"><span class="mt-2 h-2 w-2 shrink-0 rounded-full bg-yellow-300"></span>{item}</li>)}
        </ul>
      </div>
    </div>
  </div>
</section>
