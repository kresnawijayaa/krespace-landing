---
import Icon from "./Icon.astro";
import { whatsappUrlFor } from "../data/site";

const buildMessage = `Halo Krespace, saya ingin menceritakan kebutuhan project.

Jenis kebutuhan:
Kondisi project saat ini:
Target penggunaan:
Perkiraan budget:`;
---

<section class="relative overflow-hidden border-b-2 border-dark px-4 pb-20 pt-32 md:px-8 md:pb-24">
  <div class="mx-auto grid max-w-6xl items-center gap-12 lg:grid-cols-[1.08fr_0.92fr]">
    <div class="z-10">
      <div class="mb-6 flex flex-wrap gap-2">
        <span class="neo-badge bg-teal-100">Build</span>
        <span class="neo-badge bg-yellow-100">Launch</span>
        <span class="neo-badge bg-orange-100">Rescue</span>
        <span class="neo-badge bg-purple-100">Upgrade</span>
        <span class="neo-badge bg-lime-100">Care</span>
      </div>
      <h1 class="max-w-4xl text-4xl font-extrabold leading-[1.08] md:text-6xl lg:text-7xl">
        Dari ide atau source code sampai benar-benar <span class="relative inline-block text-teal-600">berjalan.<svg class="absolute -bottom-1 left-0 h-3 w-full text-yellow-400" viewBox="0 0 100 10" preserveAspectRatio="none" aria-hidden="true"><path d="M0 5 Q 50 10 100 5" stroke="currentColor" stroke-width="4" fill="none"></path></svg></span>
      </h1>
      <p class="mt-6 max-w-2xl text-lg font-medium leading-relaxed text-gray-700 md:text-xl">
        Krespace membantu membuat website dan sistem baru, menjalankan project yang belum online, memperbaiki kendala teknis, menambahkan fitur, dan merawatnya setelah digunakan.
      </p>
      <div class="mt-8 flex flex-col gap-4 sm:flex-row">
        <a href={whatsappUrlFor(buildMessage)} target="_blank" rel="noopener noreferrer" class="neo-btn bg-teal-500 px-7 py-3.5 text-white">
          Ceritakan Kebutuhanmu
        </a>
        <a href="/work" class="neo-btn gap-2 bg-white px-7 py-3.5">
          Lihat Hasil Kerja <Icon name="ArrowRight" class="h-5 w-5" />
        </a>
      </div>
      <p class="mt-5 text-sm font-semibold text-gray-500">Tidak harus teknis. Mulai dari kondisi project yang ada sekarang.</p>
    </div>

    <div class="relative" aria-label="Alur project dari source code sampai online dan dirawat">
      <div class="absolute -bottom-4 -right-4 h-full w-full rounded-2xl border-2 border-dark bg-yellow-300"></div>
      <div class="relative overflow-hidden rounded-2xl border-2 border-dark bg-white shadow-neo-lg">
        <div class="mockup-header items-center">
          <div class="mockup-dot bg-orange-400"></div>
          <div class="mockup-dot bg-yellow-300"></div>
          <div class="mockup-dot bg-lime-400"></div>
          <span class="ml-auto text-xs font-extrabold uppercase text-gray-500">Project journey</span>
        </div>
        <div class="space-y-3 p-5 md:p-7">
          <div class="grid grid-cols-[auto_1fr_auto] items-center gap-4 rounded-xl border-2 border-dark bg-gray-50 p-4">
            <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-purple-500 text-white neo-border"><Icon name="Code2" class="h-5 w-5" /></div>
            <div><p class="text-xs font-bold uppercase text-gray-500">Input</p><p class="font-extrabold">Ide atau source code</p></div>
            <span class="neo-badge hidden bg-purple-100 sm:inline-flex">CHECK</span>
          </div>
          <div class="ml-5 h-5 border-l-2 border-dashed border-dark"></div>
          <div class="grid grid-cols-[auto_1fr_auto] items-center gap-4 rounded-xl border-2 border-dark bg-orange-50 p-4">
            <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-orange-500 text-white neo-border"><Icon name="Wrench" class="h-5 w-5" /></div>
            <div><p class="text-xs font-bold uppercase text-gray-500">Process</p><p class="font-extrabold">Build, Rescue, atau Upgrade</p></div>
            <span class="neo-badge hidden bg-orange-100 sm:inline-flex">WORK</span>
          </div>
          <div class="ml-5 h-5 border-l-2 border-dashed border-dark"></div>
          <div class="grid grid-cols-[auto_1fr_auto] items-center gap-4 rounded-xl border-2 border-dark bg-teal-50 p-4">
            <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-teal-500 text-white neo-border"><Icon name="Rocket" class="h-5 w-5" /></div>
            <div><p class="text-xs font-bold uppercase text-gray-500">Output</p><p class="font-extrabold">Online, digunakan, dan dirawat</p></div>
            <span class="neo-badge hidden bg-lime-100 sm:inline-flex">LIVE</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
